---
import type { AboutItem } from '../../data/about';

interface Props {
  items: AboutItem[];
}
const { items } = Astro.props;
---

<!-- One animation panel per dial item. The dial script toggles the "on" class on the active one. -->
<div class="viz" aria-hidden="true">
  {items.map((item) => (
    <div class="v" data-viz={item.viz}>
      {item.viz === 'ripples' && (
        <Fragment>
          <div class="rip"></div>
          <div class="rip"></div>
          <div class="rip"></div>
          <div class="cdot"></div>
        </Fragment>
      )}
      {item.viz === 'bowl' && (
        <Fragment>
          <svg class="vsvg" viewBox="0 0 400 340" fill="none">
            <path class="steam" d="M150 150c-16-20 16-34 0-56c-10-14 6-26 0-40" />
            <path class="steam s2" d="M200 160c-16-20 16-34 0-56c-10-14 6-26 0-40" />
            <path class="steam s3" d="M250 150c-16-20 16-34 0-56c-10-14 6-26 0-40" />
            <path class="bowl nd" d="M104 184c10-14 20 14 30 0s20 14 30 0s20 14 30 0" />
            <path class="bowl nd n2" d="M120 172c10-14 20 14 30 0s20 14 30 0" />
            <g class="bowl chk">
              <path d="M246 150C246 126 270 110 292 118C314 126 320 154 298 172C282 186 246 178 246 150Z" />
              <path d="M306 124L334 96" />
              <circle cx="339" cy="91" r="5" />
              <circle cx="330" cy="102" r="5" />
              <path d="M262 138l7 4M282 128l6 6M268 160l8-3M292 148l6 6M284 168l7-3M300 136l4 7" />
            </g>
            <path class="bowl" d="M80 190H320A120 120 0 0 1 80 190Z" />
            <path class="bowl" d="M160 312H240" />
          </svg>
        </Fragment>
      )}
      {item.viz === 'equalizer' && (
        <Fragment>
          <div class="eq">
            <span class="bar" style="--t:1.1s;--l:0s;--h:.55"></span>
            <span class="bar" style="--t:.9s;--l:.15s;--h:.9"></span>
            <span class="bar" style="--t:1.3s;--l:.05s;--h:.7"></span>
            <span class="bar" style="--t:.8s;--l:.3s;--h:1"></span>
            <span class="bar" style="--t:1.2s;--l:.1s;--h:.65"></span>
            <span class="bar" style="--t:.95s;--l:.4s;--h:.95"></span>
            <span class="bar" style="--t:1.05s;--l:.2s;--h:.5"></span>
            <span class="bar" style="--t:.85s;--l:.35s;--h:.8"></span>
            <span class="bar" style="--t:1.25s;--l:.25s;--h:.6"></span>
          </div>
        </Fragment>
      )}
      {item.viz === 'sword' && (
        <Fragment>
          <svg class="vsvg" viewBox="0 0 400 340" fill="none">
            <path class="slash" d="M70 250C140 200 260 120 340 70" />
            <path class="swd" d="M82 160H146V216C146 244 114 262 114 262C114 262 82 244 82 216Z" />
            <path class="swd" d="M114 160V258M82 200H146" />
            <path
              class="swd flame"
              d="M296 276C274 256 284 234 296 214C298 232 320 240 312 266C308 276 302 278 296 276Z"
            />
            <path class="swd flame f2" d="M296 276C288 266 292 256 296 248C298 256 306 260 302 270Z" />
            <g class="sw">
              <path class="swd" d="M200 40L212 70V230H188V70Z" />
              <path class="swd" d="M200 52V224" />
              <path class="swd" d="M160 230H240" />
              <path class="swd" d="M200 230V280" />
              <circle class="swd" cx="200" cy="292" r="7" />
              <path class="glint" d="M200 52l4 10l10 4l-10 4l-4 10l-4-10l-10-4l10-4Z" />
            </g>
          </svg>
        </Fragment>
      )}
      {item.viz === 'pipeline' && (
        <Fragment>
          <div class="pline">
            <span class="pn a">
              <i></i>
            </span>
            <span class="pn b">
              <i></i>
            </span>
            <span class="pn c">
              <i></i>
            </span>
            <span class="pdot"></span>
          </div>
        </Fragment>
      )}
      {item.viz === 'shurikens' && (
        <Fragment>
          <svg class="vsvg" viewBox="0 0 400 340" fill="none">
            <g class="fruit">
              <circle class="swd" cx="200" cy="160" r="34" />
              <path class="swd" d="M200 160a4 4 0 0 1 8 0a9 9 0 0 1-18 0a14 14 0 0 1 28 0a19 19 0 0 1-38 0" />
              <path class="swd" d="M200 126q2-14 14-18" />
            </g>
            <g class="star s1">
              <g class="spin">
                <path class="swd" d="M0-26L7-7L26 0L7 7L0 26L-7 7L-26 0L-7-7Z" />
                <circle class="swd" r="3" />
              </g>
            </g>
            <g class="star s2">
              <g class="spin rev">
                <path class="swd" d="M0-26L7-7L26 0L7 7L0 26L-7 7L-26 0L-7-7Z" />
                <circle class="swd" r="3" />
              </g>
            </g>
            <g class="star s3">
              <g class="spin">
                <path class="swd" d="M0-26L7-7L26 0L7 7L0 26L-7 7L-26 0L-7-7Z" />
                <circle class="swd" r="3" />
              </g>
            </g>
            <g class="staff">
              <path class="swd" d="M60 300H340" />
              <path class="swd" d="M60 295V305M340 295V305" />
            </g>
          </svg>
        </Fragment>
      )}
      {item.viz === 'eye' && (
        <Fragment>
          <svg class="vsvg" viewBox="0 0 400 240" fill="none">
            <g class="eye">
              <path class="eyeline" d="M50 120C110 40 290 40 350 120C290 200 110 200 50 120Z" />
              <g class="iris">
                <circle class="irisc" cx="200" cy="120" r="38" />
                <circle class="pupil" cx="200" cy="120" r="14" />
              </g>
            </g>
          </svg>
        </Fragment>
      )}
      <span class="mono cap">{item.caption}</span>
    </div>
  ))}
</div>
