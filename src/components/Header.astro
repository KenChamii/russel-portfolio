---
import { profile } from '../data/profile';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#hire', label: 'Hire me' },
  { href: '#contact', label: 'Contact' },
  { href: '/about', label: 'About me' },
];
---

<header class="container site-header">
  <a class="logo" href="#top" aria-label="Back to top">
    {profile.initials}
  </a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu>
    <span class="sr-only">Menu</span>
    <i></i>
    <i></i>
  </button>
  <nav class="nav" id="primary-nav" aria-label="Primary">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const header = btn?.closest('.site-header');
  if (btn && header) {
    const set = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => set(!header.classList.contains('menu-open')));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) {
        set(false);
        btn.focus();
      }
    });
  }
</script>
